  OBS
      LAYER TopMetal1 ;
        RECT 0.0 0.0 90.300 90.300 ;
      LAYER Metal5 ;
        RECT 0.0 0.0 90.300 90.300 ;
  END
END logo_fabulous
END LIBRARY
