VERSION 5.7 ;
  NOWIREEXTENSIONATPIN ON ;
  DIVIDERCHAR "/" ;
  BUSBITCHARS "[]" ;
MACRO logo_fabulous
  CLASS BLOCK ;
  FOREIGN logo_fabulous ;
  ORIGIN 0.000 0.000 ;
